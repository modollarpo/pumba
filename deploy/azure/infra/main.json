          ],
          "outputs": {
            "playtubeUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('playtubeName')), '2023-01-01').defaultHostName)]"
            },
            "ytApiUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('ytApiName')), '2023-01-01').defaultHostName)]"
            },
            "ttApiUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('ttApiName')), '2023-01-01').defaultHostName)]"
            }
          }
        }
      },
      "dependsOn": [
        "acr",
        "data"
      ]
    },
    "acr": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "acr",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "registryName": {
            "value": "[parameters('registryName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "5818577494200899151"
            }
          },
          "parameters": {
            "registryName": {
              "type": "string"
            }
          },
          "resources": {
            "acr": {
              "existing": true,
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-01-01",
              "name": "[parameters('registryName')]"
            }
          },
          "outputs": {
            "loginServer": {
              "type": "string",
              "value": "[reference('acr').loginServer]"
            },
            "username": {
              "type": "string",
              "value": "[listCredentials('acr', '2023-01-01').username]"
            },
            "password": {
              "type": "securestring",
              "value": "[listCredentials('acr', '2023-01-01').passwords[0].value]"
            }
          }
        }
      }
    },
    "vm": {
      "condition": "[parameters('deployVm')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "mediamtx-vm",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          },
          "customer": {
            "value": "[parameters('customer')]"
          },
          "adminUser": {
            "value": "[parameters('vmAdminUser')]"
          },
          "sshPublicKey": {
            "value": "[parameters('vmAdminSshPublicKey')]"
          },
          "vmSize": {
            "value": "[parameters('vmSize')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "2367186692340924317"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "customer": {
              "type": "string"
            },
            "adminUser": {
              "type": "string"
            },
            "sshPublicKey": {
              "type": "string"
            },
            "vmSize": {
              "type": "string",
              "defaultValue": "Standard_B1s",
              "allowedValues": [
                "Standard_B1s",
                "Standard_B1ls",
                "Standard_B2pts_v2"
              ],
              "metadata": {
                "description": "VM size (all three are in the 12-month free 750h offer; pick the one the region has capacity for)."
              }
            }
          },
          "variables": {
            "vmName": "[format('vm-{0}-{1}', parameters('customer'), parameters('environment'))]",
            "nicName": "[format('{0}-nic', variables('vmName'))]",
            "pipName": "[format('{0}-pip', variables('vmName'))]",
            "nsgName": "[format('{0}-nsg', variables('vmName'))]",
            "vnetName": "[format('vnet-{0}', variables('vmName'))]",
            "cloudInitScript": "#cloud-config\npackage_update: true\npackages:\n  - docker.io\n  - docker-compose-v2\n  - php-cli\n  - php-mysql\n  - php-mbstring\n  - php-curl\n  - php-zip\n  - php-gd\n  - php-xml\nruncmd:\n  - [ systemctl, enable, --now, docker ]\n  - docker run -d --name mediamtx --restart unless-stopped -p 1935:1935 -p 8554:8554 -p 8888:8888 -p 8889:8889 -p 8080:8080 bluenviron/mediamtx:latest-ffmpeg\n  - systemctl disable --now ufw || true\n"
          },
          "resources": [
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2022-11-01",
              "name": "[variables('vnetName')]",
              "location": "[parameters('location')]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "10.20.0.0/16"
                  ]
                },
                "subnets": [
                  {
                    "name": "default",
                    "properties": {
                      "addressPrefix": "10.20.0.0/24"
                    }
                  }
                ]
              },
              "tags": {
                "environment": "[parameters('environment')]",
                "customer": "[parameters('customer')]"
              }
            },
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2022-11-01",
              "name": "[variables('nsgName')]",
              "location": "[parameters('location')]",
              "properties": {
                "securityRules": [
                  {
                    "name": "ssh",
                    "properties": {
                      "priority": 100,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "22"
                    }
                  },
                  {
                    "name": "mediamtx-rtsp",
                    "properties": {
                      "priority": 200,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "8554"
                    }
                  },
                  {
                    "name": "mediamtx-rtmp",
                    "properties": {
                      "priority": 210,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "1935"
                    }
                  },
                  {
                    "name": "mediamtx-hls",
                    "properties": {
                      "priority": 220,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "8888"
                    }
                  },
                  {
                    "name": "mediamtx-webrtc",
                    "properties": {
                      "priority": 230,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "8889"
                    }
                  },
                  {
                    "name": "mediamtx-api",
                    "properties": {
                      "priority": 240,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "*",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "8080"
                    }
                  }
                ]
              },
              "tags": {
                "environment": "[parameters('environment')]",
                "customer": "[parameters('customer')]"
              }
            },
            {
              "type": "Microsoft.Network/publicIPAddresses",
              "apiVersion": "2022-11-01",
              "name": "[variables('pipName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Basic"
              },
              "properties": {
                "publicIPAllocationMethod": "Dynamic"
              },
              "tags": {
                "environment": "[parameters('environment')]",
                "customer": "[parameters('customer')]"
              }
            },
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2022-11-01",
              "name": "[variables('nicName')]",
              "location": "[parameters('location')]",
              "properties": {
                "networkSecurityGroup": {
                  "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
                },
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "privateIPAllocationMethod": "Dynamic",
                      "publicIPAddress": {
                        "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('pipName'))]"
                      },
                      "subnet": {
                        "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), '2022-11-01').subnets[0].id]"
                      }
                    }
                  }
                ]
              },
              "tags": {
                "environment": "[parameters('environment')]",
                "customer": "[parameters('customer')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]",
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('pipName'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2023-03-01",
              "name": "[variables('vmName')]",
              "location": "[parameters('location')]",
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('vmSize')]"
                },
                "osProfile": {
                  "computerName": "[variables('vmName')]",
                  "adminUsername": "[parameters('adminUser')]",
                  "linuxConfiguration": {
                    "disablePasswordAuthentication": true,
                    "ssh": {
                      "publicKeys": [
                        {
                          "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUser'))]",
                          "keyData": "[parameters('sshPublicKey')]"
                        }
                      ]
                    }
                  },
                  "customData": "[base64(variables('cloudInitScript'))]"
                },
                "storageProfile": {
                  "imageReference": {
                    "publisher": "Canonical",
                    "offer": "0001-com-ubuntu-server-jammy",
                    "sku": "22_04-lts-gen2",
                    "version": "latest"
                  },
                  "osDisk": {
                    "createOption": "FromImage",
                    "managedDisk": {
                      "storageAccountType": "Standard_LRS"
                    }
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
                    }
                  ]
                },
                "diagnosticsProfile": {
                  "bootDiagnostics": {
                    "enabled": false
                  }
                }
              },
              "tags": {
                "environment": "[parameters('environment')]",
                "customer": "[parameters('customer')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
              ]
            }
          ],
          "outputs": {
            "publicIp": {
              "type": "string",
              "value": "[if(not(equals(reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2022-11-01').ipAddress, null())), reference(resourceId('Microsoft.Network/publicIPAddresses', variables('pipName')), '2022-11-01').ipAddress, '')]"
            }
          }
        }
      }
    },
    "cron": {
      "condition": "[parameters('deployCron')]",
