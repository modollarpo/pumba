server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name play.keekii.net;
    root /var/www/pumba;
    index index.php index.html;
    charset utf-8;
    client_max_body_size 2048m;
    client_body_timeout 600s;
    ssl_certificate /etc/letsencrypt/live/play.keekii.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.keekii.net/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/pumba.access.log;
    error_log /var/log/nginx/pumba.error.log;

    # PlayTube pretty-URL routing (ported from .htaccess)
    # nginx does not read .htaccess, so these rewrites are what make
    # /watch/<id>, /shorts/<id>, /articles, ... reach index.php with
    # ?link1=<page>. Without them every pretty URL renders the home page.
    if (!-e $request_filename) {
        rewrite ^/reset-password/([^/]+)(/|)$ /index.php?link1=reset-password&code=$1 last;
        rewrite ^/confirm/(.*)/(.*)$ /index.php?link1=confirm&code=$1&email=$2 last;
        rewrite ^/finish/(.*)/(.*)$ /index.php?link1=finish&code=$1&email=$2 last;
        rewrite ^/two_factor_login/$ /index.php?link1=two_factor_login last;
        rewrite ^/two_factor_submit/$ /index.php?link1=two_factor_submit last;
        rewrite ^/v/(.*)$ /index.php?v=$1 last;
        rewrite ^/api/v(([0-9])([.][0-9]+))(/|)$ /api.php?v=$1 last;
        rewrite ^/admin-cp$ /admincp.php last;
        rewrite ^/admin-cp/(.*)$ /admincp.php?page=$1 last;
        rewrite ^/videos/category/(.*)/rss(/|)$ /index.php?link1=videos&page=category&id=$1&feed=rss last;
        rewrite ^/videos/category/(.*)/(.*)$ /index.php?link1=videos&page=category&id=$1&sub_id=$2 last;
        rewrite ^/videos/category/(.*)$ /index.php?link1=videos&page=category&id=$1 last;
        rewrite ^/videos/(.*)/rss(/|)$ /index.php?link1=videos&page=$1&feed=rss last;
        rewrite ^/videos/(.*)$ /index.php?link1=videos&page=$1 last;
        rewrite ^/articles(/|)$ /index.php?link1=articles last;
        rewrite ^/articles/category/(.*)(/|)$ /index.php?link1=articles&category_id=$1 last;
        rewrite ^/articles/read/(.*)(/|)$ /index.php?link1=read&id=$1 last;
        rewrite ^/aj/([^/.]+)/?$ /ajax.php?type=$1&first=$2 last;
        rewrite ^/aj/([^/.]+)/([^/.]+)/?$ /ajax.php?type=$1&first=$2 last;
        rewrite ^/aj/([^/.]+)/([^/.]+)/([^/.]+)/?$ /ajax.php?type=$1&first=$2&second=$3 last;
        rewrite ^/edit-video/(.*)?$ /index.php?link1=edit-video&id=$1 last;
        rewrite ^/watch/([^/]+)/list/([^/]+)(/|)?$ /index.php?link1=watch&id=$1&list=$2 last;
        rewrite ^/watch/([^/]+)(/|)?$ /index.php?link1=watch&id=$1 last;
        rewrite ^/embed/(.*)?$ /index.php?link1=embed&id=$1 last;
        rewrite ^/resend/(.*)/(.*)?$ /index.php?link1=resend&id=$1&u_id=$2 last;
        rewrite ^/redirect/(.*)?$ /index.php?link1=redirect&id=$1 last;
        rewrite ^/settings/(.*)/(.*)$ /index.php?link1=settings&page=$1&user=$2 last;
        rewrite ^/settings/(.*)$ /index.php?link1=settings&page=$1 last;
        rewrite ^/terms/([^/]+)(/|)$ /index.php?link1=terms&type=$1 last;
        rewrite ^/go_pro(/|)$ /index.php?link1=go_pro last;
        rewrite ^/ads(/|)$ /index.php?link1=ads last;
        rewrite ^/ads/create(/|)$ /index.php?link1=create_ads last;
        rewrite ^/ads/edit/(\d+)(/|)$ /index.php?link1=edit_ads&id=$1 last;
        rewrite ^/ads/analytics/(\d+)(/|)$ /index.php?link1=ads_analytics&id=$1 last;
        rewrite ^/contact-us(/|)$ /index.php?link1=contact last;
        rewrite ^/@([^/]+)(/|)$ /index.php?link1=timeline&id=$1 last;
        rewrite ^/messages/(.*)$ /index.php?link1=messages&id=$1 last;
        rewrite ^/view_analytics/(.*)$ /index.php?link1=view_analytics&id=$1 last;
        rewrite ^/video_studio/(.*)$ /index.php?link1=video_studio last;
        rewrite ^/comments/$ /index.php?link1=comments last;
        rewrite ^/dashboard/$ /index.php?link1=dashboard last;
        rewrite ^/popular_channels/$ /index.php?link1=popular_channels last;
        rewrite ^/create_article/$ /index.php?link1=create_article last;
        rewrite ^/my_articles/$ /index.php?link1=my_articles last;
        rewrite ^/edit_articles/(.*)?$ /index.php?link1=edit_articles&id=$1 last;
        rewrite ^/age_block/$ /index.php?link1=age_block last;
        rewrite ^/site-pages/(.*)$ /index.php?link1=site-pages&page_name=$1 last;
        rewrite ^/post/(.*)(/|)$ /index.php?link1=post&id=$1 last;
        rewrite ^/edit_activity/(.*)(/|)$ /index.php?link1=edit_activity&id=$1 last;
        rewrite ^/video_text/(.*)?$ /index.php?link1=video_text&id=$1 last;
        rewrite ^/shorts$ /index.php?link1=shorts last;
        rewrite ^/shorts/(.*)?$ /index.php?link1=shorts&id=$1 last;
        rewrite ^/wallet/$ /index.php?link1=wallet last;
        rewrite ^/upgraded/$ /index.php?link1=upgraded last;
        rewrite ^/developers/$ /index.php?link1=developers last;
        rewrite ^/my_apps/$ /index.php?link1=my_apps last;
        rewrite ^/create-app/$ /index.php?link1=create-app last;
        rewrite ^/app/(.*)?$ /index.php?link1=app&id=$1 last;
        rewrite ^/hashtag/(.*)?$ /index.php?link1=hashtag&id=$1 last;
        rewrite ^/([^/]+)(/|)$ /index.php?link1=$1 last;
    }

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ { try_files $uri =404; fastcgi_pass unix:/run/php/php8.3-fpm.sock; fastcgi_index index.php; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; include fastcgi_params; fastcgi_read_timeout 600s; }
    location ^~ /.well-known/acme-challenge/ { allow all; }
    location ~ /\. { deny all; }
}
